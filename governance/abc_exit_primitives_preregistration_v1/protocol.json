{
  "schema_version": "akah-abc-exit-primitives-preregistration-v1",
  "protocol_id": "AKAH_ABC_EXIT_PRIMITIVES_2019_2023_PREREGISTRATION_V1",
  "status": "FROZEN_BEFORE_ANY_NEW_ABC_RESULT",
  "research_order": [
    "C",
    "A",
    "B"
  ],
  "years": [
    2019,
    2020,
    2021,
    2022,
    2023
  ],
  "annual_run_label": "ANNUAL_ENTRY_WINDOW_WITH_NATIVE_COMPLETION_BUFFER",
  "control": {
    "identity": "FROZEN_NATIVE_CONTROL",
    "entry_logic_changed": false,
    "sizing_changed": false,
    "same_pair_changed": false,
    "capital_router_changed": false,
    "cost_model_changed": false,
    "native_protection_retained": true,
    "max_hold_hours": 168
  },
  "shared_execution_contract": {
    "spot_long_only": true,
    "candidate_arms_run_separately": true,
    "do_not_combine_abc_in_first_round": true,
    "decision_frame": "COMPLETED_4H_BARS_UTC_00_04_08_12_16_20",
    "execution": "FIRST_1H_OPEN_STRICTLY_AFTER_DECISION_TIME",
    "execute_at_actual_simulated_execution_price": true,
    "stale_threshold_fill_forbidden": true,
    "partial_exits": false,
    "pyramiding": false,
    "special_reentry": false,
    "native_close_preempts_candidate": true,
    "native_tie_priority": true,
    "candidate_order_after_signal_is_not_repriced": true,
    "missing_unusable_is_not_no_signal": true,
    "state_is_per_lifecycle": true,
    "same_pair_reentry_creates_new_state": true,
    "state_carry_between_lifecycles": false
  },
  "eligible_trade_bar": {
    "formula": "bar_open_time >= entry_time AND bar_close_time <= decision_time AND valid_completed_4h_bar",
    "entry_inside_bar": "EXCLUDE_ENTRY_SPANNING_BAR_PERMANENTLY_FROM_TRADE_STATE",
    "entry_exact_bar_open": "BAR_ELIGIBLE_AFTER_ITS_CLOSE",
    "entry_exact_bar_close": "JUST_CLOSED_BAR_INELIGIBLE; NEW_BAR_STARTING_AT_ENTRY_ELIGIBLE_AFTER_CLOSE",
    "r_before": "max(entry_price, highs of eligible bars with bar_close_time < current.bar_close_time)",
    "memory_now": "current.close > R_before",
    "duplicate_snapshot": "IDENTICAL_SNAPSHOT_PROCESSED_ONCE_ONLY"
  },
  "strategy_C": {
    "id": "NO_STRUCTURAL_PROGRESS_AFTER_12_BARS_V1",
    "eligible_bar_limit": 12,
    "ordering": [
      "memory_now = close > structural_high_previous",
      "memory_seen = memory_seen OR memory_now",
      "structural_high = max(structural_high_previous, high)",
      "eligible_bar_count += 1",
      "candidate = eligible_bar_count == 12 AND NOT memory_seen"
    ],
    "memory_on_bar_12_prevents_exit": true,
    "any_prior_memory_disables_C_permanently": true,
    "pnl_condition": false,
    "atr_condition": false,
    "regime_condition": false
  },
  "strategy_A": {
    "id": "DONCHIAN_CLOSE_BREAK_10_V1",
    "lookback": 10,
    "formula": "D_t=min(L[t-10],...,L[t-1]); candidate=C_t<D_t",
    "current_low_excluded": true,
    "equality_is_not_exit": true,
    "wick_below_close_above_is_not_exit": true,
    "market_series_not_trade_reset": true,
    "pre_entry_market_history_allowed": true,
    "requires_10_contiguous_valid_4h_bars": true
  },
  "strategy_B": {
    "id": "POST_MEMORY_ATR_RATCHET_22_3_V1",
    "atr_period": 22,
    "atr_multiplier": 3,
    "atr_type": "WILDER",
    "atr_series": "PAIR_LEVEL_CONTINUOUS_MARKET_SERIES_FROM_FROZEN_T0",
    "atr_reset_at_entry": false,
    "atr_reset_at_year": false,
    "tr0": "High_0-Low_0",
    "tr_later": "max(H-L,abs(H-C_prev),abs(L-C_prev))",
    "atr_seed": "mean(first_22_TR_values)",
    "atr_recursive": "(21*ATR_previous+TR_t)/22",
    "first_memory": {
      "hpeak": "max(entry_price, eligible highs through activation bar)",
      "stop_init": "Hpeak-3*ATR_current",
      "exit_on_activation_bar": false
    },
    "later_ordering": [
      "candidate=close_t<S_previous",
      "if no candidate: Hpeak_t=max(Hpeak_previous,high_t)",
      "if no candidate: S_t=max(S_previous,Hpeak_t-3*ATR_t)",
      "S_t becomes test level only at next eligible 4h close"
    ],
    "ratchet_never_loosens": true,
    "intrabar_stop_touch": false
  },
  "market_series_initialization": {
    "T0_per_pair": "FROZEN_FROM_DATA_AUTHORITY_AND_AVAILABILITY_BEFORE_RESULTS",
    "pre2019_warmup_has_no_trades_or_pnl": true,
    "annual_runs_reset_portfolio_state_and_capital_only": true,
    "indicator_series_do_not_reset_at_year": true,
    "checkpoint_and_recompute_from_T0_must_match_at_same_timestamp": true,
    "warmup_requirements": [
      "ATR_22",
      "DONCHIAN_10",
      "ALL_NATIVE_STATE_ENGINE_REQUIREMENTS"
    ],
    "late_listed_assets_record_availability_and_readiness": true
  },
  "annual_boundary": {
    "Y_start": "Jan 1 y 00:00 UTC",
    "Y_end": "Jan 1 y+1 00:00 UTC",
    "admission_rule": "entry_time>=Y_start AND entry_time+168h<Y_end",
    "same_rule_control_A_B_C": true,
    "check_before_admission": true,
    "forced_year_end_liquidation": false,
    "posthoc_cross_year_trade_deletion": false,
    "2023_follow_into_2024": false,
    "native_runtime_must_prove_close_by_entry_plus_168h": true,
    "open_trade_at_Y_end": "FAIL_CLOSED",
    "continuous_run_uses_same_annual_admission_mask": true
  },
  "direct_effect": {
    "control_entry_list_fixed": true,
    "control_quantity_fixed": true,
    "candidate_exit_realized_at_actual_execution_after_costs": true,
    "net_sale_proceeds_reserved_until_control_release_time": true,
