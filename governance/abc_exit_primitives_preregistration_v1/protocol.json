    "reserved_proceeds_have_no_asset_price_exposure": true,
    "reserved_proceeds_no_interest": true,
    "other_trades_and_sizes_unchanged": true,
    "formula": "sum(NetPnL_modified_exit-NetPnL_control)",
    "funding_changes_do_not_modify_fixed_entry_direct_effect": true
  },
  "signal_execution_logging": {
    "native_preempts_candidate_execution": true,
