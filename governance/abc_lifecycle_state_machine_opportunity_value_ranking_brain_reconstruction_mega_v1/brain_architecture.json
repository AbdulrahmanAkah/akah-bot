      "lambda": 10.0,
      "model": "logistic",
      "target": "I(h0_net_return_2x > 0)"
    },
    "VALUE": {
      "lambda": 10.0,
      "model": "ridge",
      "target": "h0_net_return_2x"
    },
    "XSEC_RANK": {
      "lambda": 10.0,
      "model": "ridge",
      "target": "within-entry-hour percentile rank(h0_net_return_2x)"
    }
  },
  "hyperparameter_search": false,
  "model_zoo": false,
  "schema_version": "akah-opportunity-value-brain-v1"
}
