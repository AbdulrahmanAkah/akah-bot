{
  "admission_gate": "EXACT_F10_GATE_FOR_ALL_VARIANTS",
  "architecture_id": "OVRB_V1_THREE_HEAD_LINEAR",
  "fusion": "within-hour-rank(VALUE)+within-hour-rank(POSITIVE)+within-hour-rank(XSEC_RANK)",
  "fusion_weights": [
    1.0,
    1.0,
    1.0
  ],
  "heads": {
