  "mandatory_invariants": [
    {
      "id": "INV_ALL_2020_LIFECYCLES_PRESENT",
      "statement": "Exactly 2020 frozen Control lifecycles must appear, including zero-decision lifecycles."
    },
    {
      "id": "INV_ENTRY_AND_EXIT_EXACTLY_ONCE",
      "statement": "Every lifecycle has exactly one ENTRY and one NATIVE_EXIT event."
    },
    {
      "id": "INV_EVENT_TIMESTAMPS_FROM_FROZEN_OUTPUTS_ONLY",
      "statement": "No event timestamp may be invented, shifted, interpolated or inferred between frozen timestamps."
    },
    {
      "id": "INV_SIMULTANEOUS_EVENTS_GROUPED_NO_PRIORITY",
      "statement": "Events sharing a timestamp form one unordered semantic event set; serialization order has no priority meaning."
    },
    {
      "id": "INV_EVIDENCE_EVENT_PARITY",
      "statement": "Pooled evidence event counts must remain STALLED=74, STRUCTURAL_BREAK=135, VOLATILITY_DAMAGE=31."
    },
    {
      "id": "INV_EVIDENCE_MAX_ONCE_PER_LIFECYCLE",
      "statement": "Each accepted evidence overlay occurs at most once per lifecycle under the frozen source materialization."
    },
    {
      "id": "INV_MEMORY_AND_CONFIRMED_CAUSAL_ORDER",
      "statement": "If CONFIRMED_PHASE_ENTRY exists, FIRST_MEMORY must exist and occur strictly before it."
    },
    {
      "id": "INV_STALLED_PRE_MEMORY_PHASE",
      "statement": "STALLED_EVIDENCE remains an UNCONFIRMED-phase event and cannot occur after FIRST_MEMORY."
    },
    {
      "id": "INV_VOL_DAMAGE_CONFIRMED_PHASE",
      "statement": "VOLATILITY_DAMAGE_EVIDENCE must not occur before CONFIRMED_PHASE_ENTRY."
    },
    {
      "id": "INV_NATIVE_EXIT_NOT_BEFORE_ENTRY",
      "statement": "NATIVE_EXIT timestamp must be greater than or equal to ENTRY timestamp."
    }
  ],
