  "mandatory_invariants": [
    {
      "id": "INV_STALLED_EQUALS_C_IN_UNCONFIRMED",
      "statement": "stalled_evidence_candidate iff C_signal and base_state UNCONFIRMED"
    },
    {
      "id": "INV_STRUCTURAL_BREAK_EQUALS_A",
      "statement": "structural_break_evidence_candidate iff A_signal"
    },
    {
      "id": "INV_VOL_DAMAGE_EQUALS_B_IN_CONFIRMED",
      "statement": "volatility_damage_evidence_candidate iff B_signal and base_state CONFIRMED"
    },
    {
      "id": "INV_OVERLAYS_EVENT_LOCAL",
      "statement": "No overlay carries forward to a later decision row unless its frozen source signal is true again on that row."
    },
    {
      "id": "INV_BASE_STATE_UNCHANGED",
      "statement": "Materialization must not mutate UNCONFIRMED/EARLY_PROGRESS/CONFIRMED base_state."
    },
    {
      "id": "INV_ROW_COUNT_PARITY",
      "statement": "Output decision-grid row count must equal frozen input trace row count exactly."
    }
  ],
