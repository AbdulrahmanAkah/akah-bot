  "conceptual_state_vocabulary_from_doctrine": [
    "UNCONFIRMED",
    "EARLY_PROGRESS",
    "CONFIRMED",
    "HEALTHY_TREND",
    "STALLED",
    "DETERIORATING",
    "STRUCTURAL_BREAK",
    "VOLATILITY_DAMAGE",
    "FAILED"
  ],
  "v1_operational_base_states": {
    "UNCONFIRMED": {
      "definition": "From entry until the first eligible completed 4H bar whose close is strictly above the prior post-entry structural high. Memory_seen is false.",
      "source_semantics": "FROZEN_MEMORY_SEMANTICS_FROM_ABC_PROTOCOL",
      "economic_meaning": "NONE",
      "exit_action": "NONE"
    },
    "EARLY_PROGRESS": {
      "definition": "Exactly the decision point of the first eligible completed 4H bar on which Memory_now becomes true. This is a one-decision-point transition marker, not a duration threshold.",
      "source_semantics": "FROZEN_MEMORY_SEMANTICS_FROM_ABC_PROTOCOL",
      "economic_meaning": "NONE",
      "exit_action": "NONE"
    },
    "CONFIRMED": {
      "definition": "All later eligible completed 4H decision points after the first Memory_now event, while the native Control lifecycle remains open. Memory_seen is true.",
      "source_semantics": "FROZEN_MEMORY_SEMANTICS_FROM_ABC_PROTOCOL",
      "economic_meaning": "NONE",
      "exit_action": "NONE"
    }
  },
  "conceptual_states_not_operationalized_in_v1": {
    "HEALTHY_TREND": "NO_FROZEN_CAUSAL_PREDICATE_YET",
    "STALLED": "NO_NEW_STALL_THRESHOLD_ALLOWED_IN_THIS_PROTOCOL",
    "DETERIORATING": "NO_FROZEN_CAUSAL_STATE_PREDICATE_YET",
