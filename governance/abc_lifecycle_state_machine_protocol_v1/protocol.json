  "base_state_transition_graph": [
    {
      "from": "ENTRY",
      "to": "UNCONFIRMED",
      "condition": "TRADE_OPENED",
      "reversible": false
    },
    {
      "from": "UNCONFIRMED",
      "to": "EARLY_PROGRESS",
      "condition": "FIRST_MEMORY_NOW_TRUE_ON_ELIGIBLE_COMPLETED_4H_BAR",
      "reversible": false
    },
    {
      "from": "EARLY_PROGRESS",
      "to": "CONFIRMED",
      "condition": "NEXT_ELIGIBLE_COMPLETED_4H_DECISION_POINT_IF_NATIVE_CONTROL_STILL_OPEN",
      "reversible": false
    },
    {
      "from": "ANY_OPEN_BASE_STATE",
      "to": "NATIVE_CLOSED_OBSERVATION",
      "condition": "FROZEN_NATIVE_CONTROL_EXIT",
      "reversible": false,
      "note": "NATIVE_CLOSED_OBSERVATION is terminal bookkeeping, not one of the doctrine's nine lifecycle states."
    }
  ],
  "memory_semantics": {
    "eligible_bar_rule": "bar_open_time >= entry_time AND bar_close_time <= decision_time; partial entry-spanning 4H bar excluded",
    "structural_reference_before_current": "R_before_t = max(entry_price, prior eligible completed 4H highs)",
    "memory_now": "current_completed_4H_close > R_before_t",
    "update_order": [
      "COMPUTE_MEMORY_NOW_AGAINST_PRIOR_STRUCTURAL_REFERENCE",
      "UPDATE_MEMORY_SEEN",
      "UPDATE_STRUCTURAL_HIGH"
    ],
    "one_way_latch": true
  },
