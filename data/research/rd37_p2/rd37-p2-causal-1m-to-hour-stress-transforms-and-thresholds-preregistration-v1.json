  "research_objective": "Convert Binance Spot BTCUSDT/ETHUSDT 1m public-data fields into strictly causal completed-hour stress states that may later serve as exogenous evidence for an adaptive KuCoin Spot exit controller. Freeze all transforms, thresholds, clock semantics, event semantics, diagnostic horizons, and qualification rules before observing any target returns.",
  "schema_version": "rd37-p2-causal-1m-to-hour-stress-transforms-and-thresholds-preregistration-v1",
  "stage": "RD37_P2_CAUSAL_1M_TO_HOUR_STRESS_TRANSFORMS_AND_THRESHOLDS_PREREGISTRATION",
  "status": "FROZEN_PRE_FEATURE_COMPUTATION",
  "strictly_prior_normalization": {
    "baseline_hours": 168,
    "current_hour_excluded": true,
    "invalid_when": "168 immediately preceding eligible completed source hours are not consecutive OR MAD <= 0",
    "normalized_fields": [
      "realized_volatility_z",
      "quote_volume_z",
      "trade_count_z"
    ],
    "participation_z": {
      "formula": "participation_z = 0.5*quote_volume_z + 0.5*trade_count_z"
    },
    "requires_consecutive_eligible_source_hours": true,
    "robust_z_formula": "z_h = (x_h - median(previous_168)) / (1.4826 * median(abs(previous_168 - median(previous_168))))",
    "transform_before_normalization": {
      "hour_quote_volume": "log1p(hour_quote_volume_h)",
      "hour_trade_count": "log1p(hour_trade_count_h)",
      "realized_volatility": "log1p(rv_h)"
    }
  },
  "symbol_level_transforms": {
    "downside_semivariance_share": {
      "formula": "downside_share_h = sum(min(r_m,0)^2) / sum(r_m^2)",
      "invalid_when": "sum(r_m^2) <= 0",
      "range": "[0,1]"
    },
    "hour_max_drawdown": {
      "expected_sign": "<=0",
      "formula": "max_drawdown_h = min(low_m / open_h - 1)"
    },
    "hour_quote_volume": {
      "formula": "sum(quote_volume over 60 minutes)"
    },
    "hour_return": {
      "formula": "hour_return_h = close_(h+59m) / open_h - 1"
    },
    "hour_trade_count": {
      "formula": "sum(number_of_trades over 60 minutes)"
    },
    "minute_return": {
      "formula": "r_m = ln(close_m / open_m)",
      "requires_positive_ohlc": true
    },
    "realized_volatility": {
      "formula": "rv_h = sqrt(sum(r_m^2 for all 60 minutes in h))"
    },
    "recovery_fraction": {
      "formula": "recovery_h = clip((close_(h+59m) - hour_low) / (open_h - hour_low), 0, 1)",
      "interpretation": "0 = closes at the hour low; 1 = fully recovers to the hour open or above.",
      "invalid_when": "hour_low >= open_h"
    },
    "sell_flow_acceleration": {
      "formula": "flow_accel_h = imbalance_15_h - imbalance_60_h",
      "interpretation": "More negative values mean taker flow deteriorated toward selling in the final 15 minutes."
    },
    "taker_imbalance_15m": {
      "formula": "imbalance_15_h = 2*sum(taker_buy_quote_volume_last15m) / sum(quote_volume_last15m) - 1",
      "invalid_when": "sum(quote_volume_last15m) <= 0",
      "range": "[-1,1]",
      "window": "last 15 minutes h+45m through h+59m"
    },
    "taker_imbalance_60m": {
      "formula": "imbalance_60_h = 2*sum(taker_buy_quote_volume_60m) / sum(quote_volume_60m) - 1",
      "invalid_when": "sum(quote_volume_60m) <= 0",
      "range": "[-1,1]"
    }
  }
}
