{
  "base_source_transforms": {
    "flow_acceleration": {
      "formula": "acceleration_t = pressure_6_t - pressure_24_t",
      "interpretation": "positive means recent taker flow is more buy-skewed than the 24h state; negative means deterioration toward sell flow"
    },
    "flow_pressure": {
      "formula": "pressure_L_t = arithmetic_mean(imbalance over the last L consecutive observed source bars, including t)",
      "lookbacks_hours": [
        6,
        24,
        72
      ]
    },
    "participation_quote_shock": {
      "input": "log1p(quote_volume_t)",
      "invalid_when": "168 prior consecutive source bars unavailable OR MAD <= 0",
      "normalizer": "robust_z against the immediately preceding 168 consecutive observed source bars, excluding t",
      "robust_z_formula": "(x_t - median(history)) / (1.4826 * median(abs(history - median(history))))"
    },
    "participation_shock": {
      "formula": "0.5 * participation_quote_shock + 0.5 * trade_count_shock"
    },
    "taker_buy_quote_imbalance": {
      "clipping": "numerical_guard_only_to_[-1,1]",
      "domain": "[-1, 1]",
      "invalid_when": "quote_volume_t <= 0 OR source bar unavailable",
      "symbol_level_formula": "imbalance_t = 2 * taker_buy_quote_volume_t / quote_volume_t - 1"
    },
    "trade_count_shock": {
      "input": "log1p(number_of_trades_t)",
      "invalid_when": "168 prior consecutive source bars unavailable OR MAD <= 0",
      "normalizer": "same 168h prior-only robust_z rule as participation_quote_shock"
    }
  },
  "clock_semantics": {
    "earliest_kucoin_use": "t+1h",
    "lookahead": "FORBIDDEN",
    "same_bar_cross_venue_use": "FORBIDDEN",
    "same_timestamp_target_start": "FORBIDDEN",
    "source_bar_definition": "A Binance 1h bar with open time t is information only after that bar is fully closed.",
    "target_reference_clock": "For later diagnostics, source bar t may first map to KuCoin reference time t+1h; any forward target starts from that KuCoin-native reference clock."
  },
  "cross_symbol_aggregation": {
    "aggregation_requires_both_symbols_valid": true,
    "consensus_negative": "BTCUSDT.pressure_24 < 0 AND ETHUSDT.pressure_24 < 0",
    "consensus_positive": "BTCUSDT.pressure_24 > 0 AND ETHUSDT.pressure_24 > 0",
    "flow_dispersion_24": "abs(BTCUSDT.pressure_24 - ETHUSDT.pressure_24)",
    "market_acceleration": "0.5 * BTCUSDT.acceleration + 0.5 * ETHUSDT.acceleration",
    "market_participation_shock": "0.5 * BTCUSDT.participation_shock + 0.5 * ETHUSDT.participation_shock",
    "market_pressure_24": "0.5 * BTCUSDT.pressure_24 + 0.5 * ETHUSDT.pressure_24",
    "market_pressure_6": "0.5 * BTCUSDT.pressure_6 + 0.5 * ETHUSDT.pressure_6",
    "market_pressure_72": "0.5 * BTCUSDT.pressure_72 + 0.5 * ETHUSDT.pressure_72"
  },
  "design_role": "EXOGENOUS_STATE_LAYER_FOR_FUTURE_ADAPTIVE_EXIT_BRAIN;NOT_A_DIRECT_PRODUCTION_EXIT_RULE",
  "frozen_state_families": [
    {
      "definition": "BTCUSDT.pressure_24 <= -0.10 AND ETHUSDT.pressure_24 <= -0.10",
