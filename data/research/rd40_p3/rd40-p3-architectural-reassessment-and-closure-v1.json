  "architectural_findings": {
    "finding_1": {
      "id": "WEAKNESS_AND_PATH_DETERIORATION_NOT_SUFFICIENT",
      "statement": "Neither static weakness, transition deterioration, nor post-peak recovery failure produced robust negative 24h evidence across both 2022 and 2023."
    },
    "finding_2": {
      "2022_trade_conditioned_exposure_per_universe": {
        "CAUTION": 70,
        "LOCKED": 305,
        "OPEN": 1686,
        "TOTAL": 2061
      },
      "id": "ADMISSION_GOVERNOR_IS_NOT_AN_INDEPENDENT_EXIT_CONTEXT",
      "interpretation_boundary": "THIS_IS_A_SELECTION_RISK_DIAGNOSIS,NOT_A_CLAIM_THAT_THE_GOVERNOR_ITSELF_IS_INVALID",
      "statement": "RD31 governor state is causally valid but is coupled to admission. Mature-trade decision-hour exposure can be strongly different from clock-hour occupancy; therefore it must not be treated as an independent binary exit permission variable without explicit cohort-selection controls."
    },
    "finding_3": {
      "id": "LOCKED_MEASURES_RELATIVE_SEVERITY_NOT_ABSOLUTE_EXIT_SIGN",
      "statement": "In 2023 all 9 preregistered LOCKED-vs-OPEN mean contrasts passed, yet every LOCKED 24h mean in those contrasts remained positive and no LOCKED negative family qualified. The governor therefore carried relative severity information but did not provide robust absolute negative remaining-value evidence."
    },
    "finding_4": {
      "id": "RECOVERY_VETO_IS_ALSO_REGIME_DEPENDENT",
      "statement": "FAST_POST_PEAK_RECLAIM_CONTROL was 0-of-3 qualified in 2022 and 3-of-3 qualified in 2023; it is not robust enough to serve as a universal veto."
    },
    "finding_5": {
      "id": "FIXED_24H_MARKOUT_IS_NOT_ACTION_ALIGNED_FOR_IRREVERSIBLE_EXIT",
      "statement": "A fixed 24h sign target is useful for information diagnostics but is not sufficient as the primary target for an irreversible exit whose counterfactual holding period extends to the frozen control exit."
    }
  },
